# Copy to .env and adjust. docker compose reads .env automatically. Every value below has a
# safe fallback in docker-compose.yml EXCEPT AUTH_SECRET — you must supply that yourself.

# REQUIRED — the HMAC key that signs operator tokens. There is no fallback: the stack refuses
# to start until this is set to a real secret (placeholders and repeated-char filler are also
# rejected in production). Generate one and paste it here:
#   openssl rand -hex 32
AUTH_SECRET=

# Postgres credentials (used by both the db service and the engine's DATABASE_URL).
POSTGRES_USER=verdict
POSTGRES_PASSWORD=verdict
POSTGRES_DB=verdict

# Host ports to publish the engine and dashboard on.
ENGINE_PORT=4000
DASHBOARD_PORT=3000

# Scoring: "weighted" (hand weights) or "learned" (adaptive model from your labels).
SCORER=weighted

# Tuning.
DATABASE_POOL_MAX=20
RATE_LIMIT_DECISIONS_PER_MIN=600
RATE_LIMIT_LOGIN_PER_MIN=10

# Data retention — the prune job deletes rows older than each window (days). 0 = keep forever.
# All are runtime-overridable from the dashboard (Configure → Retention); these are the defaults.
RETENTION_SWEEP_MINUTES=60
RETENTION_VERDICTS_DAYS=365
RETENTION_ACTIVITY_DAYS=90
RETENTION_REPLAY_DAYS=90
RETENTION_IDEMPOTENCY_DAYS=7
RETENTION_DEAD_LETTER_DAYS=30

# Default per-channel alert cap (alerts/minute; excess dropped). 0 = unlimited. Overridable per channel.
NOTIFY_THROTTLE_PER_MIN=60

# Proxy hops to trust for the real client IP (per-IP rate limits). Default (unset) trusts none —
# X-Forwarded-For is ignored so it can't be spoofed. Behind one proxy/LB set 1; behind two, 2.
TRUST_PROXY=1

# Operator token claims (defaults are fine). Tokens are pinned to this issuer/audience.
# AUTH_ISSUER=verdict-engine
# AUTH_AUDIENCE=verdict-operators

# Rotating AUTH_SECRET without forcing logouts: move the old secret here (comma-separated for
# more than one) while the new one is AUTH_SECRET. Tokens signed by a previous secret keep
# verifying until they expire; drop it from here once they have aged out (12h).
# AUTH_SECRET_PREVIOUS=

# REDIS_URL is wired to the bundled redis service automatically — no need to set it here.
